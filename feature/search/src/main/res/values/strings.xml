<resources>
    <!-- Name of the search screen, read aloud when it opens -->
    <string name="search_title">Search</string>
    <!-- Hint in the empty search field -->
    <string name="search_hint">Search, or paste an address</string>
    <!-- Leaves the search screen -->
    <string name="search_back">Back</string>
    <!-- Empties the search field -->
    <string name="search_clear">Clear search</string>
    <!-- Heading over the recent searches -->
    <string name="search_recent">Recent</string>
    <!-- Forgets the recent searches -->
    <string name="search_recent_clear">Clear</string>
    <!-- Filter chip above the search results: every part of the answer -->
    <string name="search_all">All</string>
    <!-- Heading over the accounts found -->
    <string name="search_accounts">Accounts</string>
    <!-- Heading over the hashtags found -->
    <string name="search_hashtags">Hashtags</string>
    <!-- Heading over the posts found -->
    <string name="search_posts">Posts</string>
    <!-- Nothing was found: %s is what was searched for -->
    <string name="search_nothing">Nothing found for “%s”.</string>
    <!-- The search could not reach the server -->
    <string name="search_offline">You are offline. Search needs a connection.</string>
    <!-- The server could not search -->
    <string name="search_error">The search did not work. Try again in a moment.</string>
    <!-- Row above the results while typing an address; %1$s is the address -->
    <string name="search_intent_open">Open %1$s</string>
    <!-- Row above the results while typing a hashtag or a word; %1$s is the tag without its # -->
    <string name="search_intent_tag">Posts tagged #%1$s</string>
    <!-- Row above the results while typing a handle; %1$s is the handle -->
    <string name="search_intent_person">Go to %1$s</string>
    <!-- Row above the results: only the posts found; %1$s is what was typed -->
    <string name="search_intent_posts">Posts matching “%1$s”</string>
    <!-- Row above the results: only the accounts found; %1$s is what was typed -->
    <string name="search_intent_accounts">Accounts matching “%1$s”</string>
</resources>
