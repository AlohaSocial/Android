<resources>
    <!-- Title of the screen showing one post and the conversation around it -->
    <string name="thread_title">Post</string>
    <!-- Button that goes back from a screen -->
    <string name="thread_back">Back</string>
    <!-- Row under a reply chain too deep to indent further; opens it as its own conversation. %d is how many replies -->
    <plurals name="thread_more_replies">
        <item quantity="one">Show %d more reply</item>
        <item quantity="other">Show %d more replies</item>
    </plurals>
    <!-- Button under the post: how many favourited it; opens the list of who did -->
    <plurals name="thread_favourites">
        <item quantity="one">%d favourite</item>
        <item quantity="other">%d favourites</item>
    </plurals>
    <!-- Button under the post: how many boosted it; opens the list of who did -->
    <plurals name="thread_boosts">
        <item quantity="one">%d boost</item>
        <item quantity="other">%d boosts</item>
    </plurals>
    <!-- The favourites button while the reader hides the numbers -->
    <string name="thread_favourites_plain">Favourites</string>
    <!-- The boosts button while the reader hides the numbers -->
    <string name="thread_boosts_plain">Boosts</string>
    <!-- Button under the post that opens the posts quoting it -->
    <string name="thread_quotes">Quotes</string>
    <!-- Button under the post that opens its emoji reactions -->
    <string name="thread_reactions">Reactions</string>
    <!-- Button under an edited post that opens its earlier versions -->
    <string name="thread_edit_history">Edit history</string>
    <!-- Snackbar in a thread when a refresh found replies the reader has not seen; the list stays where it is -->
    <string name="thread_more_replies_found">More replies found</string>
    <!-- The snackbar's button: puts the replies it found into the thread -->
    <string name="thread_more_replies_show">Show</string>
    <!-- Title of the sheet before replying to a post more than three months old -->
    <string name="thread_nudge_old_title">This post is from a while ago</string>
    <!-- Body of that sheet -->
    <string name="thread_nudge_old_body">It was posted more than three months ago. You can still reply, but it may no longer be relevant.</string>
    <!-- Title of the sheet before a first reply to someone who does not follow the reader -->
    <string name="thread_nudge_stranger_title">Before you reply</string>
    <!-- First line of that sheet -->
    <string name="thread_nudge_stranger_follow">They don’t follow you, so this may be the first they hear from you.</string>
    <!-- Second line of that sheet -->
    <string name="thread_nudge_stranger_read">Read the replies first: your point may already be made.</string>
    <!-- Third line of that sheet -->
    <string name="thread_nudge_stranger_kind">Be kind: your reply lands in their notifications.</string>
    <!-- The nudge sheet's main button: goes on to the reply -->
    <string name="thread_nudge_reply">Reply</string>
    <!-- The nudge sheet's button: goes on to the reply, and never shows this sheet again for the account in use -->
    <string name="thread_nudge_silence_account">Reply, and don’t show this again for this account</string>
    <!-- The nudge sheet's button: goes on to the reply, and never shows this sheet again on any account -->
    <string name="thread_nudge_silence_all">Reply, and don’t show this again on any account</string>
    <!-- The bar at the bottom of a thread that starts a reply; %s is the focused post's author -->
    <string name="thread_reply_to">Reply to %s</string>
    <!-- Chip shown once the post a thread is about has scrolled out of view; a tap scrolls back to it -->
    <string name="thread_back_to_post">Back to the post</string>
    <!-- What a tap on the focused post's date does, said by a screen reader -->
    <string name="thread_date_seconds">Show the seconds</string>
    <!-- After the focused post's date: the app it was written with; %s is the app's name -->
    <string name="thread_via">via %s</string>
    <!-- Heading of the sheet listing a post's earlier versions -->
    <string name="thread_history_title">Edit history</string>
    <!-- The first version of an edited post, in its history -->
    <string name="thread_history_original">Original</string>
    <!-- Strip shown when the conversation could not be loaded while offline -->
    <string name="thread_offline">You\'re offline. Showing what is saved on this device.</string>
    <!-- Strip shown when the conversation could not be loaded -->
    <string name="thread_error">Couldn\'t load the conversation. Pull down to try again.</string>
    <!-- Shown when the post was deleted or is not visible to this account -->
    <string name="thread_gone">This post is no longer available.</string>
    <!-- Read aloud on a reply: how deep it sits under the post the thread is about, 1 for a direct reply -->
    <string name="thread_reply_level">Reply, level %1$d</string>
    <!-- Read aloud while the conversation loads -->
    <string name="thread_loading">Loading the conversation</string>
    <!-- Title of the list of accounts that favourited a post -->
    <string name="thread_list_favourited_by">Favourited by</string>
    <!-- Title of the list of accounts that boosted a post -->
    <string name="thread_list_boosted_by">Boosted by</string>
    <!-- Title of the list of posts quoting a post -->
    <string name="thread_list_quotes">Quotes</string>
    <!-- Title of the list of a post's emoji reactions -->
    <string name="thread_list_reactions">Reactions</string>
    <!-- Shown when one of a post's lists is empty -->
    <string name="thread_list_empty">Nothing here yet.</string>
    <!-- Shown when one of a post's lists could not be loaded -->
    <string name="thread_list_error">Couldn\'t load this list.</string>
    <!-- Button that loads a list again after it failed -->
    <string name="thread_retry">Try again</string>
    <!-- Read aloud for one reaction in the list: %1$s the emoji or its name, %2$d how many reacted -->
    <plurals name="thread_reaction_count">
        <item quantity="one">%1$s, %2$d reaction</item>
        <item quantity="other">%1$s, %2$d reactions</item>
    </plurals>
    <!-- Confirms the reader's own post was archived -->
    <string name="thread_archived">Archived. It’s off your profile, not deleted, and can be put back from Archived posts.</string>
    <!-- Thread: the top bar's menu of what can be done with the whole thread -->
    <string name="thread_menu">More for this thread</string>
    <!-- Thread menu: summarises the thread on the device -->
    <string name="thread_summarise">Summarise this thread</string>
    <!-- Summary sheet: its heading -->
    <string name="thread_summary_title">Summary of this thread</string>
    <!-- Summary sheet while the device summarises the thread -->
    <string name="thread_summarising">Summarising on this device…</string>
    <!-- Summary sheet: over a summary of a long thread that read only its first posts: the first %1$d of all %2$d -->
    <plurals name="thread_summary_part">
        <item quantity="one">Covers the first %1$d of %2$d post</item>
        <item quantity="other">Covers the first %1$d of %2$d posts</item>
    </plurals>
    <!-- Summary sheet: over a summary made on the device -->
    <string name="thread_summary_generated">Generated on this device. It can miss or get things wrong.</string>
    <!-- Summary sheet: the device’s model declined to summarise the thread -->
    <string name="thread_summary_refused">The on-device model didn’t want to summarise this thread.</string>
    <!-- Summary sheet: the summary could not be made -->
    <string name="thread_summary_failed">This device couldn’t summarise this thread.</string>
    <!-- Summary sheet: closes it, back to the thread -->
    <string name="thread_summary_read">Read the full thread</string>
    <!-- Summary sheet: stops the summary under way -->
    <string name="thread_summary_cancel">Cancel</string>
</resources>
