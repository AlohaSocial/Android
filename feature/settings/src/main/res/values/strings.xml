<resources>
    <!-- Title of the settings screen -->
    <string name="settings_title">Settings</string>
    <!-- Button that goes back from a settings screen -->
    <string name="settings_back">Back</string>
    <!-- Shown beside the list of settings sections on a wide screen before one is opened -->
    <string name="settings_choose">Choose a section.</string>
    <!-- Title of the settings section about the app -->
    <string name="settings_about">About</string>
    <!-- The app's version in the about section; %s is the version name -->
    <string name="settings_version">Version %s</string>
    <!-- Row in the about section that opens the app's source code -->
    <string name="settings_source">Source code</string>
    <!-- Title of the settings section that connects the account to the Nextcloud its Social server runs on -->
    <string name="settings_nextcloud">Nextcloud</string>
    <!-- Explains what connecting the Nextcloud is for, before it is connected -->
    <string name="settings_nextcloud_about">Connect your Nextcloud to get notifications pushed through it and to attach files from it.</string>
    <!-- Button that starts connecting the Nextcloud; the approval happens in the browser -->
    <string name="settings_nextcloud_connect">Connect your Nextcloud</string>
    <!-- Shown while the app waits for the person to approve the connection in the browser -->
    <string name="settings_nextcloud_waiting">Approve Aloha Social in the browser that opened. This page updates when you are done.</string>
    <!-- Button that stops waiting for the approval in the browser -->
    <string name="settings_nextcloud_cancel">Cancel</string>
    <!-- Shown once connected; the app password is a credential the Nextcloud created for this device only -->
    <string name="settings_nextcloud_connected">Connected. Aloha Social holds an app password your Nextcloud created for this device.</string>
    <!-- Button that disconnects the Nextcloud and gives the app password back to it -->
    <string name="settings_nextcloud_disconnect">Disconnect</string>
    <!-- Shown when the account's server is not a Nextcloud, so there is nothing to connect -->
    <string name="settings_nextcloud_not_available">Your account is not on a Nextcloud, so there is nothing to connect.</string>
    <!-- Shown when the Nextcloud could not be reached or is in maintenance -->
    <string name="settings_nextcloud_unavailable">Your Nextcloud cannot be reached right now, or is being maintained. Try again later.</string>
    <!-- Shown when the person did not approve within five minutes -->
    <string name="settings_nextcloud_timed_out">The approval did not arrive in time. Try again.</string>
    <!-- Shown when the Nextcloud answered in a way the app could not use -->
    <string name="settings_nextcloud_failed">Your Nextcloud did not connect. Try again, or check that it is set up for this address.</string>
    <!-- Once connected: notifications arrive by push, through the Nextcloud -->
    <string name="settings_nextcloud_push_on">Notifications arrive by push through your Nextcloud.</string>
    <!-- Once connected, without a push app (a UnifiedPush distributor such as ntfy) chosen -->
    <string name="settings_nextcloud_push_no_distributor">Notifications are checked every few minutes. Choose a push app under Notifications to get them at once.</string>
    <!-- Once connected, when the Nextcloud does not push (or has not confirmed yet) -->
    <string name="settings_nextcloud_push_polled">Notifications are checked every few minutes: your Nextcloud does not push them yet.</string>
    <!-- Settings section that deletes the account in use, for good -->
    <string name="settings_delete">Delete account</string>
    <!-- What deleting does, on Nextcloud Social; %s is the handle, like @alice@example.social -->
    <string name="settings_delete_about">Deleting %s removes its posts and follows on every server that knew it. It cannot be undone. Your Nextcloud account stays.</string>
    <!-- Button that opens the confirmation to delete the account -->
    <string name="settings_delete_start">Delete this account…</string>
    <!-- On Nextcloud Social without the Nextcloud connected -->
    <string name="settings_delete_needs_nextcloud">To delete this account from here, connect your Nextcloud above first.</string>
    <!-- On any server other than Nextcloud Social -->
    <string name="settings_delete_on_web">Your server deletes accounts on its website, after you sign in there.</string>
    <!-- Button that opens the server's page for deleting the account -->
    <string name="settings_delete_open_web">Delete on the website</string>
    <!-- Title of the confirmation dialog -->
    <string name="settings_delete_title">Delete this account for good?</string>
    <!-- Body of the confirmation dialog; %s is the handle to type -->
    <string name="settings_delete_body">Type %s to confirm. Its posts and follows go, here and on every server that knew it.</string>
    <!-- Label of the field the handle is typed into -->
    <string name="settings_delete_field">Handle</string>
    <!-- Button that deletes the account, enabled once the handle matches -->
    <string name="settings_delete_confirm">Delete</string>
    <!-- Button that closes the dialog without deleting -->
    <string name="settings_delete_cancel">Cancel</string>
    <!-- Said while the server deletes the account -->
    <string name="settings_delete_deleting">Deleting…</string>
    <!-- The server limits how often deletion can be tried -->
    <string name="settings_delete_too_often">Too many tries. Try again in an hour.</string>
    <!-- Deletion failed for any other reason -->
    <string name="settings_delete_failed">The account was not deleted. Nothing changed; try again later.</string>
</resources>
