<resources>
    <!-- Title of the posts the reader bookmarked -->
    <string name="saved_bookmarks">Bookmarks</string>
    <!-- Title of the posts the reader favourited -->
    <string name="saved_favourites">Favourites</string>
    <!-- Title of the reader's own posts taken off their profile without deleting them -->
    <string name="saved_archived">Archived posts</string>
    <!-- Leaves a list of kept posts -->
    <string name="saved_back">Back</string>
    <!-- Shown when the reader has bookmarked nothing -->
    <string name="saved_bookmarks_none">Nothing bookmarked yet. A post’s bookmark keeps it here, for you alone.</string>
    <!-- Shown when the reader has favourited nothing -->
    <string name="saved_favourites_none">Nothing favourited yet.</string>
    <!-- Shown when the reader has archived nothing -->
    <string name="saved_archived_none">Nothing archived. An archived post is off your profile but not deleted, and can be put back from here.</string>
    <!-- Shown when the posts could not be loaded -->
    <string name="saved_failed">These posts couldn’t be loaded.</string>
    <!-- Loads the next page of posts -->
    <string name="saved_more">Show more</string>
    <!-- Puts an archived post back on the reader's profile -->
    <string name="saved_unarchive">Put back on profile</string>
    <!-- Spoken for an archived post's put-back button; %1$s is who wrote the post -->
    <string name="saved_unarchive_post">Put %1$s’s post back on profile</string>
    <!-- Shown when putting an archived post back failed -->
    <string name="saved_unarchive_failed">The post couldn’t be put back. It is still archived.</string>
</resources>
