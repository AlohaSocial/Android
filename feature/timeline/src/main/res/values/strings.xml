<resources>
    <!-- Follows a hashtag, so its posts come home -->
    <string name="tag_follow">Follow hashtag</string>
    <!-- Stops following a hashtag -->
    <string name="tag_unfollow">Unfollow hashtag</string>
    <!-- Before the hashtags used together with this one -->
    <string name="tag_related">Used with</string>
    <!-- What was asked for normalises to nothing, or the server refused it -->
    <string name="tag_not_a_tag">That isn’t a hashtag.</string>
    <!-- Toolbar button on Home that opens search -->
    <string name="timeline_search">Search</string>
    <!-- Floating button on the home timeline that opens the composer for a new post -->
    <string name="timeline_compose">New post</string>
    <!-- Title of the home timeline screen -->
    <string name="timeline_title">Home</string>
    <!-- Title of the timeline of posts with photos -->
    <string name="timeline_title_photos">Photos</string>
    <!-- Title of the timeline of posts with videos -->
    <string name="timeline_title_video">Video</string>
    <!-- Title of the timeline of short vertical videos -->
    <string name="timeline_title_shorts">Shorts</string>
    <!-- Title of the timeline of posts that share a link to an article -->
    <string name="timeline_title_news">News</string>
    <!-- Title of the timeline of posts with audio -->
    <string name="timeline_title_audio">Audio</string>
    <!-- Source switch: the people the reader follows -->
    <string name="timeline_source_home">Following</string>
    <!-- Source switch: everyone on the reader's own server -->
    <string name="timeline_source_local">This server</string>
    <!-- Source switch: everyone the reader's server knows of -->
    <string name="timeline_source_federated">Everywhere</string>
    <!-- Menu of timeline options -->
    <string name="timeline_options">Timeline options</string>
    <!-- Timeline option: show boosts of other people's posts -->
    <string name="timeline_show_boosts">Show boosts</string>
    <!-- Timeline option: show replies to other people -->
    <string name="timeline_show_replies">Show replies</string>
    <!-- Pill above the list when new posts arrived while reading; %d is how many -->
    <plurals name="timeline_new_posts">
        <item quantity="one">%d new post</item>
        <item quantity="other">%d new posts</item>
    </plurals>
    <!-- Strip over the timeline when the server cannot be reached; the cached posts stay -->
    <string name="timeline_offline">You\'re offline. These are the posts saved on this device.</string>
    <!-- Strip over the timeline when the server answered with an error -->
    <string name="timeline_error">Couldn\'t refresh. Pull down to try again.</string>
    <!-- Strip over the timeline when the server asks the app to slow down -->
    <string name="timeline_rate_limited">Your server asked the app to slow down. Try again in a moment.</string>
    <!-- A row standing for posts not loaded yet between two parts of the timeline -->
    <string name="timeline_gap">Load missing posts</string>
    <!-- The same row, for a reader scrolling up to it: the posts load just above the ones they read -->
    <string name="timeline_gap_above">Load missing posts above</string>
    <!-- The same row, for a reader scrolling down to it: the posts load just below the ones they read -->
    <string name="timeline_gap_below">Load missing posts below</string>
    <!-- Title of the empty timeline -->
    <string name="timeline_empty_title">Nothing here yet</string>
    <!-- Text of the empty home timeline -->
    <string name="timeline_empty_home">Follow people and their posts show up here.</string>
    <!-- Button in the empty home timeline that switches to the reader's server's public posts -->
    <string name="timeline_empty_explore">See what\'s happening on this server</string>
    <!-- Text of an empty public timeline -->
    <string name="timeline_empty_public">No posts here yet.</string>
    <!-- Title of the settings section that turns the News and Audio modes on -->
    <string name="modes_settings_title">Modes</string>
    <!-- Title of the sheet offering the optional modes once, after the first account -->
    <string name="modes_offer_title">Make it yours</string>
    <!-- Body of the sheet offering the optional modes -->
    <string name="modes_offer_body">Photos, Video and Shorts are always there. More can join them; you can change this later in Settings, under Modes.</string>
    <!-- Button that closes the sheet offering the optional modes -->
    <string name="modes_offer_done">Done</string>
    <!-- Heading of the choice of which mode an optional mode replaces in a phone's navigation bar, which holds three -->
    <string name="modes_settings_phone">On a phone, in place of</string>
    <!-- Summary of the News mode's switch -->
    <string name="modes_settings_news">Posts that share an article, as large link cards</string>
    <!-- Summary of the Audio mode's switch -->
    <string name="modes_settings_audio">Posts with sound, which keep playing in the background</string>
    <!-- Button in the photos toolbar that opens what is trending with pictures, hashtags and people -->
    <string name="photos_explore">Explore</string>
    <!-- Button in the photos toolbar that opens the reader's albums -->
    <string name="photos_albums">Albums</string>
    <!-- Button in the photos toolbar that shows the photos as a grid of squares -->
    <string name="photos_show_grid">Show as grid</string>
    <!-- Button in the photos toolbar that shows the photos one below the other, with their posts -->
    <string name="photos_show_feed">Show as feed</string>
    <!-- A square in the photo grid, read aloud: %1$s is who posted, %2$d how many pictures the post holds -->
    <plurals name="photos_cell">
        <item quantity="one">Photo by %1$s</item>
        <item quantity="other">%2$d photos by %1$s</item>
    </plurals>
    <!-- Read aloud for a square in the photo grid whose picture has no description -->
    <string name="photos_cell_no_alt">no description</string>
    <!-- Read aloud for a square in the photo grid whose picture is marked sensitive and hidden -->
    <string name="photos_cell_sensitive">marked sensitive</string>
    <!-- What tapping a square in the photo grid does, read aloud -->
    <string name="photos_cell_open">open the photos</string>
    <!-- Under an empty photos, video or shorts timeline: the server cannot pick such posts itself -->
    <string name="timeline_empty_sparse">This server cannot pick these posts out itself, so the app looks through recent posts for them, and there may be few.</string>
    <!-- Read aloud while the first page of the timeline loads -->
    <string name="timeline_loading">Loading posts</string>
    <!-- Swipe action on a post, read aloud: favourite it -->
    <string name="timeline_swipe_favourite">Favourite</string>
    <!-- Swipe action on a post, read aloud: boost it -->
    <string name="timeline_swipe_boost">Boost</string>
    <!-- Button that goes back from a hashtag's timeline -->
    <string name="timeline_back">Back</string>
    <!-- What a swipe on a post does: bookmark it -->
    <string name="timeline_swipe_bookmark">Bookmark</string>
    <!-- What a swipe on a post does: open it to reply -->
    <string name="timeline_swipe_reply">Reply</string>
    <!-- What a swipe on a post does: nothing, the post stays still -->
    <string name="timeline_swipe_none">Nothing</string>
    <!-- Title of the timeline section in the settings -->
    <string name="timeline_settings_title">Timeline</string>
    <!-- Heading of the choice for a swipe from the start of a post towards its end -->
    <string name="timeline_settings_swipe_end">Swipe towards the end</string>
    <!-- Heading of the choice for a swipe from the end of a post towards its start -->
    <string name="timeline_settings_swipe_start">Swipe towards the start</string>
    <!-- Supporting text under the show-boosts and show-replies settings -->
    <string name="timeline_settings_account">For the account in use</string>
    <!-- Under a hashtag's header when whether it is followed could not be loaded: tries again -->
    <string name="tag_retry">Couldn’t load this hashtag. Try again</string>
    <!-- Under a hashtag's follow button when following or unfollowing failed -->
    <string name="tag_follow_failed">That didn’t work. Nothing was changed.</string>
    <!-- Timeline setting: heading over which of Home's timelines the app opens on, for the account in use -->
    <string name="timeline_settings_home_opens">Home opens on</string>
    <!-- Timeline setting: a timeline opens where it was left -->
    <string name="timeline_settings_restore">Open where I left off</string>
    <!-- Summary of the setting above -->
    <string name="timeline_settings_restore_summary">Off, a timeline opens at the newest post</string>
    <!-- Timeline setting: new posts wait behind a button at the top -->
    <string name="timeline_settings_pill">Hold new posts behind a button</string>
    <!-- Summary of the setting above -->
    <string name="timeline_settings_pill_summary">Off, new posts join the timeline as they arrive, without moving what you read</string>
</resources>

