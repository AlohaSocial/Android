<resources>
    <!-- Under a list in the lists dialog that follows a Nextcloud group, which cannot be ticked -->
    <string name="profile_lists_group">Follows a Nextcloud group</string>
    <!-- Button that goes back from a screen -->
    <string name="profile_back">Back</string>
    <!-- Button with the profile's other actions -->
    <string name="profile_more">More</string>
    <!-- Button that follows the account -->
    <string name="profile_follow">Follow</string>
    <!-- Button that follows an account that already follows the reader -->
    <string name="profile_follow_back">Follow back</string>
    <!-- Button showing the reader follows the account; tapping it unfollows -->
    <string name="profile_following">Following</string>
    <!-- Button showing a follow request is waiting; tapping it withdraws the request -->
    <string name="profile_requested">Requested</string>
    <!-- Button that unblocks the account -->
    <string name="profile_unblock">Unblock</string>
    <!-- Badge on a profile that follows the reader -->
    <string name="profile_follows_you">Follows you</string>
    <!-- Badge on a profile whose followers are approved by hand -->
    <string name="profile_locked">Approves followers</string>
    <!-- Badge on an automated account -->
    <string name="profile_bot">Automated</string>
    <!-- Read aloud for a profile field whose link the server checked -->
    <string name="profile_field_verified">verified</string>
    <!-- Count of the account's posts; %s is the formatted number -->
    <plurals name="profile_posts">
        <item quantity="one">%s post</item>
        <item quantity="other">%s posts</item>
    </plurals>
    <!-- Count of accounts it follows; opens the list. %s is the formatted number -->
    <string name="profile_following_count">%s following</string>
    <!-- Opens the list of accounts it follows, while the reader hides the numbers -->
    <string name="profile_following_plain">Following</string>
    <!-- Opens the list of its followers, while the reader hides the numbers -->
    <string name="profile_followers_plain">Followers</string>
    <!-- Count of its followers; opens the list. %s is the formatted number -->
    <plurals name="profile_followers">
        <item quantity="one">%s follower</item>
        <item quantity="other">%s followers</item>
    </plurals>
    <!-- Menu item that mutes the account -->
    <string name="profile_mute">Mute</string>
    <!-- Menu item that unmutes the account -->
    <string name="profile_unmute">Unmute</string>
    <!-- Menu item that blocks the account -->
    <string name="profile_block">Block</string>
    <!-- Menu item on a wide screen or beside another app: opens the profile in a window of its own -->
    <string name="profile_new_window">Open in new window</string>
    <!-- Menu item that opens the profile on its own server, in the browser -->
    <string name="profile_open_in_browser">Open in browser</string>
    <!-- Title of the dialog confirming a block; %s is the handle -->
    <string name="profile_block_title">Block %s?</string>
    <!-- Body of the dialog confirming a block -->
    <string name="profile_block_body">They can\'t follow you or see your posts, and you won\'t see theirs.</string>
    <!-- Button that confirms a block -->
    <string name="profile_block_confirm">Block</string>
    <!-- Button that cancels a dialog -->
    <string name="profile_cancel">Cancel</string>
    <!-- Tab with the account's posts, without its replies -->
    <string name="profile_tab_posts">Posts</string>
    <!-- Tab with the account's posts and replies -->
    <string name="profile_tab_replies">Posts &amp; replies</string>
    <!-- Tab with the account's posts carrying images or video -->
    <string name="profile_tab_media">Media</string>
    <!-- Tab with the account's videos -->
    <string name="profile_tab_videos">Videos</string>
    <!-- Tab with the account's media collections -->
    <string name="profile_tab_collections">Collections</string>
    <!-- Tab with the account's current stories -->
    <string name="profile_tab_stories">Stories</string>
    <!-- Heading of the strip showing twelve weeks of posting -->
    <string name="profile_highlights">Last 12 weeks</string>
    <!-- How much the account posted in the last twelve weeks; %d is the number -->
    <plurals name="profile_highlights_total">
        <item quantity="one">%d post</item>
        <item quantity="other">%d posts</item>
    </plurals>
    <!-- The account has not posted lately -->
    <string name="profile_rhythm_quiet">Quiet lately</string>
    <!-- The account posts more than usual lately -->
    <string name="profile_rhythm_busier">Posting more lately</string>
    <!-- The account posts less than usual lately -->
    <string name="profile_rhythm_slowing">Posting less lately</string>
    <!-- The account posts about as usual -->
    <string name="profile_rhythm_steady">Posting steadily</string>
    <!-- A collection's size; %d is how many posts it holds -->
    <plurals name="profile_collection_size">
        <item quantity="one">%d post</item>
        <item quantity="other">%d posts</item>
    </plurals>
    <!-- Shown when a profile tab has nothing -->
    <string name="profile_empty">Nothing here yet.</string>
    <!-- Shown when the profile does not exist or is not visible to this account -->
    <string name="profile_gone">This profile isn\'t available.</string>
    <!-- Strip shown when the profile could not be refreshed while offline -->
    <string name="profile_offline">You\'re offline. Showing what is saved on this device.</string>
    <!-- Strip shown when the profile could not be loaded -->
    <string name="profile_error">Couldn\'t load this profile. Pull down to try again.</string>
    <!-- Button that fills a gap of posts not loaded yet -->
    <string name="profile_gap">Load missing posts</string>
    <!-- Read aloud while the profile loads -->
    <string name="profile_loading">Loading the profile</string>
    <!-- Title of the list of an account's followers -->
    <string name="profile_followers_title">Followers</string>
    <!-- Title of the list of accounts an account follows -->
    <string name="profile_following_title">Following</string>
    <!-- Shown when a list of accounts could not be loaded -->
    <string name="profile_people_error">Couldn\'t load this list.</string>
    <!-- Button that loads a list again after it failed -->
    <string name="profile_retry">Try again</string>
    <!-- Menu item, checked when the followed account's boosts show in the reader's home -->
    <string name="profile_show_boosts">Show their boosts</string>
    <!-- Menu item, checked when each of the followed account's posts notifies the reader -->
    <string name="profile_notify">Notify me of their posts</string>
    <!-- Menu item that opens the reader's lists to put the account on, and that dialog's title -->
    <string name="profile_lists">Add to lists</string>
    <!-- Shown when the reader has no lists -->
    <string name="profile_lists_none">You have no lists yet.</string>
    <!-- Menu item that opens the reader's private note about the account, and that dialog's title -->
    <string name="profile_note">Personal note</string>
    <!-- Label of the note field -->
    <string name="profile_note_label">Note</string>
    <!-- Under the note field: nobody else sees it -->
    <string name="profile_note_private">Only you can see this.</string>
    <!-- Button that saves the note -->
    <string name="profile_save">Save</string>
    <!-- Button that closes the lists dialog -->
    <string name="profile_done">Done</string>
    <!-- Title of the mute dialog; the placeholder is the account, like @alice@example.social -->
    <string name="profile_mute_title">Mute %1$s?</string>
    <!-- Mute length: until the reader unmutes -->
    <string name="profile_mute_forever">Until I unmute</string>
    <!-- Mute length: an hour -->
    <string name="profile_mute_hour">For an hour</string>
    <!-- Mute length: a day -->
    <string name="profile_mute_day">For a day</string>
    <!-- Mute length: a week -->
    <string name="profile_mute_week">For a week</string>
    <!-- Checkbox in the mute dialog: their notifications go quiet too -->
    <string name="profile_mute_notifications">Hide their notifications too</string>
    <!-- Menu item that blocks the account's whole server -->
    <string name="profile_block_domain">Block their server</string>
    <!-- Menu item that unblocks the account's whole server -->
    <string name="profile_unblock_domain">Unblock their server</string>
    <!-- Title of the dialog asking before a whole server is blocked; the placeholder is its domain -->
    <string name="profile_block_domain_title">Block all of %1$s?</string>
    <!-- Body of that dialog -->
    <string name="profile_block_domain_body">Nothing from anyone there shows anywhere, and the followers you have there are removed.</string>
    <!-- Menu item that makes the account stop following the reader -->
    <string name="profile_remove_follower">Remove as follower</string>
    <!-- Title of the dialog asking before a follower is removed; the placeholder is the account -->
    <string name="profile_remove_follower_title">Remove %1$s as a follower?</string>
    <!-- Body of that dialog -->
    <string name="profile_remove_follower_body">They stop following you without being told. They can follow you again.</string>
    <!-- Button that confirms removing the follower -->
    <string name="profile_remove_follower_confirm">Remove</string>
    <!-- Button on one's own profile that opens it for editing -->
    <string name="profile_edit">Edit profile</string>
    <!-- Title of the profile editor -->
    <string name="profile_edit_title">Edit profile</string>
    <!-- Shown when one's own profile could not be loaded for editing -->
    <string name="profile_edit_failed">Your profile couldn\'t be loaded.</string>
    <!-- Label of the display name field -->
    <string name="profile_edit_name">Display name</string>
    <!-- Label of the bio field -->
    <string name="profile_edit_bio">Bio</string>
    <!-- Heading above the profile's extra fields, like a website or pronouns -->
    <string name="profile_edit_fields">Extra fields</string>
    <!-- Label of one extra field's name; the placeholder is its number -->
    <string name="profile_edit_field_name">Label %1$d</string>
    <!-- Label of one extra field's content; the placeholder is its number -->
    <string name="profile_edit_field_value">Content %1$d</string>
    <!-- Button that picks a new header picture -->
    <string name="profile_edit_header">Change header</string>
    <!-- Button that picks a new profile picture -->
    <string name="profile_edit_avatar">Change picture</string>
    <!-- Button that removes the header picture -->
    <string name="profile_edit_remove_header">Remove header</string>
    <!-- Button that removes the profile picture -->
    <string name="profile_edit_remove_avatar">Remove picture</string>
    <!-- Switch: follow requests are approved by hand -->
    <string name="profile_edit_locked">Approve followers by hand</string>
    <!-- Switch: the account is marked as a bot -->
    <string name="profile_edit_bot">This account is a bot</string>
    <!-- Switch: the profile may be suggested to others -->
    <string name="profile_edit_discoverable">Suggest my profile to others</string>
    <!-- Switch: search engines may include one's public posts -->
    <string name="profile_edit_indexable">Let search engines include my public posts</string>
    <!-- Switch: media start out marked sensitive -->
    <string name="profile_edit_sensitive">Mark my media sensitive by default</string>
    <!-- Button showing who new posts reach by default; the placeholder is one of the three below -->
    <string name="profile_edit_privacy">New posts: %1$s</string>
    <!-- Default reach of new posts: everyone -->
    <string name="profile_edit_privacy_public">Public</string>
    <!-- Default reach of new posts: everyone, kept off public timelines -->
    <string name="profile_edit_privacy_unlisted">Quiet public</string>
    <!-- Default reach of new posts: followers only -->
    <string name="profile_edit_privacy_private">Followers only</string>
    <!-- Snackbar when the server keeps the name and picture itself, for a person signed in through a directory -->
    <string name="profile_edit_managed">Your server manages your name and picture.</string>
    <!-- Snackbar when the server refused the changes without saying why -->
    <string name="profile_edit_refused">The server didn\'t take these changes.</string>
    <!-- Snackbar when the server could not be reached -->
    <string name="profile_edit_unreached">Your profile couldn\'t be saved. Try again in a moment.</string>
    <!-- Menu item that opens a report about the account -->
    <string name="profile_report">Report</string>
    <!-- Title of the report screen; the placeholder is the account, like @alice@example.social -->
    <string name="profile_report_title">Report %1$s</string>
    <!-- Heading above the report's categories -->
    <string name="profile_report_why">What is wrong?</string>
    <!-- Report category: spam -->
    <string name="profile_report_spam">It is spam</string>
    <!-- Report category: illegal content -->
    <string name="profile_report_legal">It is illegal</string>
    <!-- Report category: it breaks the server's rules -->
    <string name="profile_report_violation">It breaks the server\'s rules</string>
    <!-- Report category: something else -->
    <string name="profile_report_other">Something else</string>
    <!-- Heading above the server's rules, to pick which were broken -->
    <string name="profile_report_rules">Which rules?</string>
    <!-- Label of the report's comment field, for the moderators -->
    <string name="profile_report_comment">Anything the moderators should know</string>
    <!-- Checkbox: a copy of the report goes to the moderators of the account's own server -->
    <string name="profile_report_forward">Send a copy to their server\'s moderators too</string>
    <!-- Button that sends the report -->
    <string name="profile_report_send">Send report</string>
    <!-- Shown when the report could not be sent -->
    <string name="profile_report_failed">That didn\'t go through. Try again in a moment.</string>
    <!-- Heading once the report is sent -->
    <string name="profile_report_sent">Thanks, your report is on its way</string>
    <!-- Body once the report is sent; the placeholder is the account -->
    <string name="profile_report_sent_body">The moderators decide what happens next. Until then, you can stop seeing %1$s yourself.</string>
    <!-- Button label once the account is muted after reporting -->
    <string name="profile_report_muted">Muted</string>
    <!-- Button label once the account is blocked after reporting -->
    <string name="profile_report_blocked">Blocked</string>
    <!-- What a screen reader says for the posting highlights: %1$s is the heading ("Highlights"), %2$s how many posts (“12 posts”), %3$s the rhythm (“Posting steadily”) -->
    <string name="profile_highlights_spoken">%1$s: %2$s, %3$s</string>
</resources>
