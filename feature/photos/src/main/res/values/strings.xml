<resources>
    <!-- Back button of the collection screens -->
    <string name="photos_back">Back</string>
    <!-- Title of the screen listing collections, named sets of posts with pictures -->
    <string name="collections_title">Collections</string>
    <!-- Button and dialog title that make a new collection -->
    <string name="collections_new">New collection</string>
    <!-- Confirms the name of a new collection and makes it -->
    <string name="collections_create">Create</string>
    <!-- Menu item and dialog title that rename a collection -->
    <string name="collections_rename">Rename</string>
    <!-- Confirms a collection's new name -->
    <string name="collections_rename_confirm">Save</string>
    <!-- Menu item and confirm button that delete a collection -->
    <string name="collections_delete">Delete</string>
    <!-- Title of the question before a collection is deleted: %s is its name -->
    <string name="collections_delete_title">Delete “%s”?</string>
    <!-- Text of the question before a collection is deleted -->
    <string name="collections_delete_body">The collection goes; the posts in it stay.</string>
    <!-- Closes the collection name dialog without a change -->
    <string name="collections_cancel">Cancel</string>
    <!-- Label of the collection name field -->
    <string name="collections_name">Name</string>
    <!-- Label of the collection description field -->
    <string name="collections_description">What it holds (optional)</string>
    <!-- Name shown for a collection that has none -->
    <string name="collections_untitled">Untitled collection</string>
    <!-- How many posts a collection holds -->
    <plurals name="collections_posts">
        <item quantity="one">%d post</item>
        <item quantity="other">%d posts</item>
    </plurals>
    <!-- Button with a collection's rename and delete, read aloud: %s is the collection's name -->
    <string name="collections_options">Options for %s</string>
    <!-- Shown when the reader has no collections -->
    <string name="collections_none_own">No collections yet. Make one, then add your posts with pictures to it.</string>
    <!-- Shown when another account has no collections -->
    <string name="collections_none">No collections.</string>
    <!-- Shown when collections or their posts could not be loaded -->
    <string name="collections_failed">The collections could not be loaded.</string>
    <!-- Tries loading the collections again -->
    <string name="collections_retry">Try again</string>
    <!-- Shown when the server did not take a change to a collection -->
    <string name="collections_change_failed">The collection could not be changed.</string>
    <!-- Shown in a collection without posts -->
    <string name="collection_empty">No posts in this collection yet.</string>
    <!-- A post in a collection, read aloud: %s is who posted it -->
    <string name="collection_post">Post by %s</string>
    <!-- Read aloud for a post in a collection whose picture has no description -->
    <string name="collection_post_no_alt">no description</string>
    <!-- Read aloud for a post whose picture is marked sensitive and hidden behind its blur -->
    <string name="collection_post_sensitive">marked sensitive</string>
    <!-- What tapping a post in a collection does, read aloud -->
    <string name="collection_open">open the post</string>
    <!-- Takes a post out of a collection -->
    <string name="collection_remove">Remove from collection</string>
    <!-- Title of Photos' Explore, what is trending with pictures and who is popular -->
    <string name="explore_title">Explore</string>
    <!-- Heading of the pictures trending on the reader's server -->
    <string name="explore_trending">Trending</string>
    <!-- Heading of the pictures trending across the servers the reader's server knows -->
    <string name="explore_network">Across the network</string>
    <!-- Heading of the trending hashtags -->
    <string name="explore_tags">Hashtags</string>
    <!-- Heading of the popular accounts -->
    <string name="photos_people">People</string>
    <!-- Shown when nothing is trending -->
    <string name="explore_empty">Nothing is trending right now.</string>
    <!-- Title of the screen that puts a post into a collection -->
    <string name="add_to_collection_title">Add to collection</string>
    <!-- Read aloud for a collection the post was just added to -->
    <string name="add_to_collection_added">added</string>
</resources>
