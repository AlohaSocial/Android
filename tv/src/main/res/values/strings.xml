<resources>
    <!-- The TV app's name in the TV's app row -->
    <string name="tv_app_name">Aloha Social</string>
    <!-- Heading of the TV's sign-in screen -->
    <string name="tv_sign_in_title">Sign in to Aloha Social</string>
    <!-- Asks for the server before signing in on the TV -->
    <string name="tv_sign_in_body">Enter the server your account is on. You’ll finish signing in on your phone.</string>
    <!-- Label of the input where the server address is entered -->
    <string name="tv_server_label">Server, like cloud.example.org</string>
    <!-- Button that looks for the server entered -->
    <string name="tv_continue">Continue</string>
    <!-- Shown while the TV looks for the server or finishes signing in -->
    <string name="tv_working">One moment…</string>
    <!-- Next to the QR code of the sign-in page; %1$s is the server -->
    <string name="tv_scan">Scan the code with your phone, sign in to %1$s and allow Aloha Social. Then enter the code the page shows.</string>
    <!-- Spoken description of the QR code; %1$s is the server -->
    <string name="tv_qr_described">QR code of the sign-in page on %1$s</string>
    <!-- Label of the input where the code from the sign-in page is entered -->
    <string name="tv_code_label">Code from the sign-in page</string>
    <!-- Button that signs in with the code entered -->
    <string name="tv_sign_in">Sign in</string>
    <!-- Button that goes back to entering another server -->
    <string name="tv_other_server">Use another server</string>
    <!-- The text entered was not a server address -->
    <string name="tv_problem_address">That isn’t a server address. Try something like cloud.example.org.</string>
    <!-- The address asks for an unencrypted connection, which the app does not use -->
    <string name="tv_problem_insecure">That server doesn’t use a secure connection (https), so Aloha Social can’t sign in there.</string>
    <!-- No server answered at the address entered -->
    <string name="tv_problem_unreachable">No server answered there. Check the address and the TV’s connection.</string>
    <!-- Something answered, but not a server Aloha Social can sign in to -->
    <string name="tv_problem_not_a_server">Something answered there, but not a server Aloha Social can sign in to.</string>
    <!-- The server's certificate is not trusted; the phone app can be told to trust it, the TV cannot -->
    <string name="tv_problem_certificate">The server’s certificate isn’t trusted by this TV. Sign in on your phone to review it.</string>
    <!-- The server answered, but signing in failed there -->
    <string name="tv_problem_server">The server didn’t finish the sign-in. Try again.</string>
    <!-- The code typed was refused; a new sign-in page has been started -->
    <string name="tv_problem_code">That code didn’t work. Scan the new code and try again.</string>
    <!-- Heading of the screen with the account the TV is signed in to -->
    <string name="tv_account">Account</string>
    <!-- Who the TV is signed in as; %1$s is the handle, %2$s the server -->
    <string name="tv_signed_in_as">Signed in as @%1$s on %2$s</string>
    <!-- Button that signs the TV out and gives its token back to the server -->
    <string name="tv_sign_out">Sign out</string>
    <!-- Button and heading of search, which finds videos and people -->
    <string name="tv_search">Search</string>
    <!-- Label of the search input -->
    <string name="tv_search_label">Videos and channels</string>
    <!-- Shown when a search found no video and no one -->
    <string name="tv_search_none">No videos or channels found.</string>
    <!-- Shown when a search could not be done -->
    <string name="tv_search_failed">Couldn’t search. Check the TV’s connection.</string>
    <!-- Shown when someone's channel has no videos -->
    <string name="tv_channel_empty">No videos here yet.</string>
    <!-- Shown on the home screen when no shelf has anything in it -->
    <string name="tv_nothing_yet">Nothing to watch yet. Follow people who post videos, and they’ll show up here.</string>
    <!-- Shelf of the videos the reader stopped part way through -->
    <string name="tv_shelf_continue">Continue watching</string>
    <!-- Shelf of the videos of the people the reader follows -->
    <string name="tv_shelf_home">From people you follow</string>
    <!-- Shelf of short vertical videos of the people the reader follows -->
    <string name="tv_shelf_shorts">Shorts</string>
    <!-- Shelf of the people the reader follows, each a channel to open -->
    <string name="tv_shelf_following">Channels you follow</string>
    <!-- Shelf of the videos of everyone the server knows -->
    <string name="tv_shelf_federated">From everyone</string>
    <!-- Shelf of the videos many are watching now -->
    <string name="tv_shelf_trending">Trending</string>
    <!-- Over a video marked sensitive whose picture is not shown -->
    <string name="tv_sensitive">Sensitive content</string>
    <!-- Over a video marked sensitive that waits to be asked for -->
    <string name="tv_sensitive_video">This video is marked as sensitive</string>
    <!-- Button that plays a video marked sensitive -->
    <string name="tv_watch_anyway">Watch anyway</string>
    <!-- Under a covered short: how to show it -->
    <string name="tv_press_to_watch">Press OK to watch it.</string>
    <!-- Shown when a video could not be loaded -->
    <string name="tv_load_failed">Couldn’t load this. Check the TV’s connection.</string>
    <!-- Button that loads again -->
    <string name="tv_retry">Try again</string>
    <!-- Button that follows who posted the video -->
    <string name="tv_follow">Follow</string>
    <!-- Button that stops following who posted the video -->
    <string name="tv_unfollow">Unfollow</string>
    <!-- Button that reports the video to the server's moderators -->
    <string name="tv_report">Report</string>
    <!-- In place of the report button once the report went through -->
    <string name="tv_reported">Reported</string>
    <!-- Heading of the choice of what a report is about -->
    <string name="tv_report_title">What’s wrong with this video?</string>
    <!-- Report reason: spam -->
    <string name="tv_report_spam">It’s spam</string>
    <!-- Report reason: against the law -->
    <string name="tv_report_legal">It’s illegal</string>
    <!-- Report reason: anything else -->
    <string name="tv_report_other">Something else</string>
    <!-- Button that closes a choice without choosing -->
    <string name="tv_cancel">Cancel</string>
    <!-- Shown when a follow or a report did not go through -->
    <string name="tv_action_failed">That didn’t go through. Try again.</string>
    <!-- Heading of a video's chapters, each a point to jump to -->
    <string name="tv_chapters">Chapters</string>
    <!-- Shown in Shorts when the people followed posted none -->
    <string name="tv_no_shorts">No shorts yet.</string>
</resources>
