<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- the phone app saying it signed an account out; Data Layer messages come only from this app -->
        <service
            android:name=".PhoneSignOutService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/aloha/handover/signed-out"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
