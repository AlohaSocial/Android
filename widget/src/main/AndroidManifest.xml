<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- asked for by the launcher while a widget is placed; nothing else starts it -->
        <activity
            android:name="social.aloha.widget.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="social.aloha.widget.UnreadWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_unread_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread" />
        </receiver>

        <receiver
            android:name="social.aloha.widget.MentionsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_mentions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mentions" />
        </receiver>

        <receiver
            android:name="social.aloha.widget.LatestPostsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_latest_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_latest" />
        </receiver>

        <receiver
            android:name="social.aloha.widget.ComposeWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_compose_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compose" />
        </receiver>
    </application>
</manifest>
