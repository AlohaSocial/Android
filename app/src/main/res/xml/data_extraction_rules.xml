<!-- API 31+. The vault (tokens, secrets) and the disposable cache never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
        <exclude domain="database" path="cache.db" />
        <exclude domain="database" path="cache.db-wal" />
        <exclude domain="database" path="cache.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
        <exclude domain="database" path="cache.db" />
        <exclude domain="database" path="cache.db-wal" />
        <exclude domain="database" path="cache.db-shm" />
    </device-transfer>
</data-extraction-rules>
