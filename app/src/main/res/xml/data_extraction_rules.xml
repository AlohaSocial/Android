<!--
  API 31+. The vault (tokens, secrets) and the disposable cache never leave the device, nor do the
  posts not yet out (drafts, direct messages among them) and the copies of what they attach, nor
  WorkManager's store, which holds push keys and tokens while their work waits.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
        <exclude domain="database" path="cache.db" />
        <exclude domain="database" path="cache.db-wal" />
        <exclude domain="database" path="cache.db-shm" />
        <exclude domain="database" path="outbox.db" />
        <exclude domain="database" path="outbox.db-wal" />
        <exclude domain="database" path="outbox.db-shm" />
        <exclude domain="file" path="uploads" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
        <exclude domain="database" path="cache.db" />
        <exclude domain="database" path="cache.db-wal" />
        <exclude domain="database" path="cache.db-shm" />
        <exclude domain="database" path="outbox.db" />
        <exclude domain="database" path="outbox.db-wal" />
        <exclude domain="database" path="outbox.db-shm" />
        <exclude domain="file" path="uploads" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </device-transfer>
</data-extraction-rules>
