<resources>
    <!-- In the account sheet: opens the reader's direct conversations -->
    <string name="accounts_messages">Direct messages</string>
    <!-- In the account sheet: opens the posts the reader bookmarked -->
    <string name="accounts_bookmarks">Bookmarks</string>
    <!-- In the account sheet: opens the posts the reader favourited -->
    <string name="accounts_favourites">Favourites</string>
    <!-- In the account sheet: opens the reader's own posts taken off their profile without deleting them -->
    <string name="accounts_archived">Archived posts</string>
    <!-- In the account sheet: opens the reader's filters, which hide or warn about posts by keyword -->
    <string name="accounts_filters">Filters</string>
    <!-- In the account sheet: opens what the reader's server announces to everyone on it -->
    <string name="accounts_announcements">Announcements</string>
    <!-- In the account sheet: opens the hashtags the reader's Nextcloud Social server learnt they care about -->
    <string name="accounts_interests">Interests</string>
    <!-- In the account sheet: opens the reader's lists -->
    <string name="accounts_lists">Lists</string>
    <!-- In the account sheet: opens the hashtags the reader follows and their tag groups -->
    <string name="accounts_hashtags">Hashtags</string>
    <!-- Leaves a list's timeline -->
    <string name="list_back">Back</string>
    <!-- Opens who is in a list, from its timeline -->
    <string name="list_members">People in this list</string>
    <!-- The name under the launcher icon and in system settings. A brand name, not translated. -->
    <string name="app_name" translatable="false">Aloha Social</string>
    <!-- Navigation item: the home timeline of the signed-in account. -->
    <string name="destination_home">Home</string>
    <!-- Navigation item: the photo mode, a grid of posts with pictures. -->
    <string name="destination_photos">Photos</string>
    <!-- Navigation item: the video mode, long videos. -->
    <string name="destination_video">Video</string>
    <!-- Navigation item: the shorts mode, short vertical videos. Keep it short, it sits under an icon. -->
    <string name="destination_shorts">Shorts</string>
    <!-- Navigation item: the news mode, posts that share an article, once turned on. Keep it short. -->
    <string name="destination_news">News</string>
    <!-- Navigation item: the audio mode, posts with sound, once turned on. Keep it short. -->
    <string name="destination_audio">Audio</string>
    <!-- Navigation item: mentions, favourites, boosts and follows. -->
    <string name="destination_notifications">Notifications</string>
    <!-- Banner when the server no longer accepts this account's sign-in; %s is the account's handle -->
    <string name="reauth_banner">%s needs to sign in again. Nothing was lost.</string>
    <!-- Button on that banner that starts a new sign-in -->
    <string name="reauth_sign_in_again">Sign in again</string>
    <!-- Button in the top bar that opens the accounts; %s is the handle of the account in use -->
    <string name="accounts_button">Accounts, signed in as %s</string>
    <!-- Heading of the sheet listing the signed-in accounts -->
    <string name="accounts_title">Accounts</string>
    <!-- Read aloud for the account in use, in the list of accounts -->
    <string name="accounts_active">In use</string>
    <!-- Marks an account whose server refused its sign-in -->
    <string name="accounts_needs_reauth">Needs a new sign-in</string>
    <!-- Opens the profile of the account in use -->
    <string name="accounts_profile">Your profile</string>
    <!-- Opens the settings -->
    <string name="accounts_settings">Settings</string>
    <!-- Starts signing in to one more account -->
    <string name="accounts_add">Add account</string>
    <!-- Signs the account in use out of this device; %s is its handle -->
    <string name="accounts_sign_out">Sign out of %s</string>
    <!-- Title of the dialog confirming a sign-out; %s is the handle -->
    <string name="accounts_sign_out_title">Sign out of %s?</string>
    <!-- Body of the dialog confirming a sign-out -->
    <string name="accounts_sign_out_body">This device forgets the account and what it saved for it. The account and its posts stay on its server.</string>
    <!-- Button that confirms a sign-out -->
    <string name="accounts_sign_out_confirm">Sign out</string>
    <!-- Button that cancels a dialog -->
    <string name="accounts_cancel">Cancel</string>
    <!-- Shown in the right-hand pane on a wide screen before a post or profile is opened -->
    <string name="detail_nothing_open">Choose a post or a profile to read it here.</string>
    <!-- Launcher shortcut (long-press the icon) that starts a new post. Keep it to about ten characters. -->
    <string name="shortcut_compose">New post</string>
    <!-- The same shortcut where the launcher has room for a longer label -->
    <string name="shortcut_compose_long">Write a new post</string>
    <!-- Launcher shortcut that opens search. Keep it to about ten characters. -->
    <string name="shortcut_search">Search</string>
    <!-- Launcher and share-sheet shortcut of one signed-in account; %s is its handle, like @alice@example.social -->
    <string name="shortcut_post_as">Post as %s</string>
    <!-- In another app's share sheet: opens the shared post in this app instead of writing a new one -->
    <string name="open_in_aloha">Open in Aloha</string>
    <!-- Heading of the app's keys in the system's keyboard shortcuts list -->
    <string name="keys_timeline">Timeline</string>
    <!-- Keyboard shortcut J: selects the next post in a timeline -->
    <string name="keys_next">Next post</string>
    <!-- Keyboard shortcut K: selects the previous post -->
    <string name="keys_previous">Previous post</string>
    <!-- Keyboard shortcut O (or Enter): opens the selected post's thread -->
    <string name="keys_open">Open post</string>
    <!-- Keyboard shortcuts F and L: favourite the selected post -->
    <string name="keys_favourite">Favourite</string>
    <!-- Keyboard shortcut B: boosts the selected post -->
    <string name="keys_boost">Boost</string>
    <!-- Keyboard shortcut R: replies to the selected post -->
    <string name="keys_reply">Reply</string>
    <!-- Keyboard shortcut N: starts a new post -->
    <string name="keys_compose">New post</string>
</resources>
